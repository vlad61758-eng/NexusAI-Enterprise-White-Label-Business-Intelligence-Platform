# Your Telegram API ID and Hash (Get these from https://my.telegram.org)
API_ID=1234567
API_HASH=your_api_hash_here

# Comma-separated list of chats to monitor (e.g., @group1, @group2 or -100123456789)
TARGET_CHATS=@example_group1,@example_group2

# Comma-separated list of keywords to monitor for
KEYWORDS=lead,marketing,b2b,buy,need

# The channel or chat where alerts will be sent.
# Use 'me' to send to your Saved Messages, or a specific username/ID like @my_admin_channel
ADMIN_CHANNEL=me
