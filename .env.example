# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# Comma-separated list of target chats/groups to monitor
# Example: @python_chat, https://t.me/tech_group, 123456789
TARGET_CHATS=chat1,chat2

# Comma-separated list of keywords to monitor for
# Example: python, developer, looking for job
KEYWORDS=keyword1,keyword2,keyword3

# Chat where alerts will be sent
# Can be 'me' for Saved Messages, or a specific chat/channel username/ID
ADMIN_CHAT=me

# ==========================================
# AI Auto-Reply Configuration
# Enable AI auto-reply to matched leads (True/False)
AI_AUTO_REPLY=False
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==========================================
# Sales Bot Credentials
# Get this token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your personal Telegram Username (for contact)
# Example: @vlad_owner
OWNER_USERNAME=@your_username

# ==========================================
# Reddit Bot Credentials (Optional)
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET
REDDIT_USERNAME=YOUR_REDDIT_USERNAME
REDDIT_PASSWORD=YOUR_REDDIT_PASSWORD

# URL of your automated store (where the Reddit bot will send traffic)
STORE_URL=https://your-server-ip-or-domain.com
