# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# Comma-separated list of target chats/groups to monitor
# Example: @python_chat, https://t.me/tech_group, 123456789
TARGET_CHATS=chat1,chat2

# Comma-separated list of keywords to monitor for
# Example: python, developer, looking for job
KEYWORDS=keyword1,keyword2,keyword3

# Chat where alerts will be sent
# Can be 'me' for Saved Messages, or a specific chat/channel username/ID
ADMIN_CHAT=me
